# Database Configuration
DATABASE_URL=postgres://username:password@host:5432/dbname?sslmode=require
POSTGRES_URL=postgres://username:password@host:5432/dbname?sslmode=require

# Solana RPC / Helius API Key (Optional: for real on-chain holder sampling & live mints)
# Get free key from https://helius.dev
HELIUS_API_KEY=

# Twitter / X API v2 Configuration
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=
TWITTER_BEARER_TOKEN=
TWITTER_AUTO_POST_ENABLED=false
TWITTER_POST_INTERVAL_HOURS=2
TWITTER_MANAGED_BY_HANDLE=@EpochLabsHQ

# Xiaomi MiMo LLM Configuration
MIMO_API_KEY=
MIMO_BASE_URL=https://token-plan-sgp.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.5-pro

# Network & Environment
ENVIRONMENT=production
NETWORK=mainnet
DEFAULT_CHAIN=robinhood
DEFAULT_CHAIN_LABEL=Robinhood Chain Mainnet

# Contract Addresses
TOKEN_CA=0xb71463fbe6a6edef8d9d8cb0ccb5ab84cd0a353e
EPOCH_TOKEN_CA=0xb71463fbe6a6edef8d9d8cb0ccb5ab84cd0a353e

# Epochs page (Robinhood Chain 4663). Addresses default to contracts/deployments/robinhood.json
CHAIN_RPC_URL=https://rpc.mainnet.chain.robinhood.com
BLOCKSCOUT_BASE=https://robinhoodchain.blockscout.com
# Leave empty until the burn rules are published (Epoch IV stays locked)
EPC_BURN_ADDRESS=
# Leave empty until the repo is public (Epoch VI stays locked), e.g. epochlabs/golem
GOLEM_GITHUB_REPO=
GOLEM_RELEASE_TAG=golem-v1
GITHUB_TOKEN=
EPOCH_WATCHER_ENABLED=true
MODEL_WORKER_ENABLED=true

# The Desk (live trading page). Trading values are placeholders until the Open questions are decided.
DESK_WORKER_ENABLED=true
DESK_ENTRY_THRESHOLD=0.65
DESK_POSITION_SIZE_ETH=0.05
DESK_MAX_OPEN=3
DESK_TP_MC_USD=30000
DESK_SL_MC_USD=5000
DESK_MAX_HOLD_H=48
DESK_MIN_LIQ_USD=5000
DESK_START_ETH=1.0
# Comma-separated token addresses Golem must never buy (EPC and the banana token are always excluded)
DESK_EXCLUDED_TOKENS=
# X auto-post for Desk entries/exits (live only when TWITTER_AUTO_POST_ENABLED=true too)
DESK_X_POST_ENABLED=false
DESK_X_POST_DELAY_SECONDS=600
DESK_PUBLIC_URL=https://epochlabs.run/desk
# Executor: off | dry_run (logs what it would do, writes nothing) | live (refused until a signer is configured)
DESK_EXECUTOR_MODE=off
DESK_MAX_WALLET_FRACTION=0.2
DESK_GAS_RESERVE_ETH=0.005
DESK_SLIPPAGE_BPS=500

# Background writers. Run each of them in ONE deployment per database. A local backend pointed at the
# production database should set INGEST/TWITTER_SCHEDULER/EPOCH_WATCHER to false while production runs them.
INGEST_WORKER_ENABLED=true
TWITTER_SCHEDULER_ENABLED=true
# Alchemy Robinhood Chain RPC (https://robinhood-mainnet.g.alchemy.com/v2/<key>); log scans stay on CHAIN_RPC_URL
RH_MAINNET_RPC_URL=
