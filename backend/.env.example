# Database Configuration
DATABASE_URL=postgres://username:password@host:5432/dbname?sslmode=require
POSTGRES_URL=postgres://username:password@host:5432/dbname?sslmode=require

# Solana RPC / Helius API Key (Optional: for real on-chain holder sampling & live mints)
# Get free key from https://helius.dev
HELIUS_API_KEY=

# Twitter / X API v2 Configuration
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=
TWITTER_BEARER_TOKEN=
TWITTER_AUTO_POST_ENABLED=false
TWITTER_POST_INTERVAL_HOURS=2
TWITTER_MANAGED_BY_HANDLE=@EpochLabsHQ

# Xiaomi MiMo LLM Configuration
MIMO_API_KEY=
MIMO_BASE_URL=https://token-plan-sgp.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.5-pro

# Network & Environment
ENVIRONMENT=production
NETWORK=mainnet
DEFAULT_CHAIN=robinhood
DEFAULT_CHAIN_LABEL=Robinhood Chain Mainnet

# Contract Addresses
TOKEN_CA=0xb71463fbe6a6edef8d9d8cb0ccb5ab84cd0a353e
EPOCH_TOKEN_CA=0xb71463fbe6a6edef8d9d8cb0ccb5ab84cd0a353e

# Epochs page (Robinhood Chain 4663). Addresses default to contracts/deployments/robinhood.json
CHAIN_RPC_URL=https://rpc.mainnet.chain.robinhood.com
BLOCKSCOUT_BASE=https://robinhoodchain.blockscout.com
# Leave empty until the burn rules are published (Epoch IV stays locked)
EPC_BURN_ADDRESS=
# Leave empty until the repo is public (Epoch VI stays locked), e.g. epochlabs/golem
GOLEM_GITHUB_REPO=
GOLEM_RELEASE_TAG=golem-v1
GITHUB_TOKEN=
EPOCH_WATCHER_ENABLED=true
MODEL_WORKER_ENABLED=true

# The Desk (live trading page). Trading values are placeholders until the Open questions are decided.
DESK_WORKER_ENABLED=true
DESK_ENTRY_THRESHOLD=0.65
DESK_POSITION_SIZE_ETH=0.05
DESK_MAX_OPEN=3
DESK_TP_MC_USD=30000
DESK_SL_MC_USD=5000
DESK_MAX_HOLD_H=48
DESK_MIN_LIQ_USD=5000
DESK_START_ETH=1.0
# Comma-separated token addresses Golem must never buy (EPC and the banana token are always excluded)
DESK_EXCLUDED_TOKENS=
# X auto-post for Desk entries/exits (live only when TWITTER_AUTO_POST_ENABLED=true too)
DESK_X_POST_ENABLED=false
DESK_X_POST_DELAY_SECONDS=600
DESK_PUBLIC_URL=https://epochlabs.run/desk
# Executor: off | dry_run (logs what it would do, writes nothing) | live (refused until a signer is configured)
DESK_EXECUTOR_MODE=off
DESK_MAX_WALLET_FRACTION=0.2
DESK_GAS_RESERVE_ETH=0.005
DESK_SLIPPAGE_BPS=500

# Background writers. Run each of them in ONE deployment per database. A local backend pointed at the
# production database should set INGEST/TWITTER_SCHEDULER/EPOCH_WATCHER to false while production runs them.
INGEST_WORKER_ENABLED=true
TWITTER_SCHEDULER_ENABLED=true
# Alchemy Robinhood Chain RPC (https://robinhood-mainnet.g.alchemy.com/v2/<key>); log scans stay on CHAIN_RPC_URL
RH_MAINNET_RPC_URL=

# GoForge: live tracking of every launched token (Blockscout + DexScreener, 48h verdict)
GOFORGE_WORKER_ENABLED=true
GOFORGE_WORKER_INTERVAL_SECONDS=900
GOFORGE_PUBLIC_URL=https://epochlabs.run/goforge
GOFORGE_DEX_CHAIN=robinhood

# GoForge Registry (community launch). Every value is a default until the owner confirms it.
GF_ENABLED=true
GF_SUBMIT_OPEN_HOUR_UTC=0
GF_SUBMIT_CLOSE_HOUR_UTC=12
GF_VOTE_CLOSE_HOUR_UTC=20
GF_ANNOUNCE_MINUTE_UTC=5
GF_MAX_IDEAS_PER_DAY=100
# EPC burned to submit an idea. 0 = free: no fee, no transaction to check.
GF_SUBMIT_FEE_EPC=1000
GF_VOTE_MIN_EPC=1000
GF_VOTE_MIN_WALLET_AGE_DAYS=7
GF_VOTE_CHANGES_PER_HOUR=30
GF_WIN_COOLDOWN_DAYS=7
# Login. Without GF_SESSION_SECRET (a long random string) nobody can log in.
GF_SESSION_SECRET=
GF_SIWE_DOMAIN=epochlabs.run
GF_SIWE_URI=https://epochlabs.run/goforge
GF_FRONTEND_URL=https://epochlabs.run/goforge
# X OAuth 2.0 app (users.read tweet.read). Redirect URI = <backend>/api/goforge/auth/x/callback
GF_X_CLIENT_ID=
GF_X_CLIENT_SECRET=
GF_X_REDIRECT_URI=
# The team cannot submit or vote (Golem's own wallets are always included)
GF_TEAM_WALLETS=
GF_TEAM_X_USER_IDS=
# Manual review + launch registration (header X-Admin-Token). Empty = the admin API is off.
GF_ADMIN_TOKEN=
# manual = Golem schedules, the team launches on Pons and registers the CA. pons = not integrated (refuses).
GF_LAUNCH_MODE=manual
GF_PONS_URL_TEMPLATE=
# FeeSplitterFactory address and the keeper key that calls distribute() (off when the key is empty)
GF_SPLITTER_FACTORY=
GF_KEEPER_PRIVATE_KEY=
# Announcements on X: live only together with TWITTER_AUTO_POST_ENABLED, otherwise dry runs
# Development only: open submissions and votes at any hour. Keep false in production.
GF_DEV_OPEN=false
GF_X_POST_ENABLED=false
# Longest post (weighted characters) the X account can send. 280 standard; higher with X Premium.
GF_X_MAX_CHARS=280
# Extra stock tickers / blocked names, comma separated (the base lists are in backend/config)
GF_EXTRA_STOCK_TICKERS=
GF_EXTRA_BLOCKED_NAMES=
