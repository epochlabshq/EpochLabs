# API and WebSocket backend endpoints (Set to your Railway backend URL in Vercel)
NEXT_PUBLIC_API_BASE_URL=https://web-production-xxxx.up.railway.app
NEXT_PUBLIC_WS_BASE_URL=wss://web-production-xxxx.up.railway.app
BACKEND_URL=https://web-production-xxxx.up.railway.app

# GoForge page: leave unset or false to show "Coming soon"; set true when the first launch is near
NEXT_PUBLIC_GOFORGE_LIVE=false
# The GoForge session is an HttpOnly cookie, so the browser must talk to the API through this site (/api/* is rewritten to
# BACKEND_URL). Register the X OAuth redirect as https://<this site>/api/goforge/auth/x/callback and set the backend's
# GF_X_REDIRECT_URI to the same URL.

# GoForge wallet connect (RainbowKit). Optional: a WalletConnect project id from https://cloud.reown.com enables the QR code and
# mobile wallets (Rainbow, MetaMask mobile, Trust...). Without it, browser wallets and Coinbase Wallet still work.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
