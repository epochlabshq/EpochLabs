# API and WebSocket backend endpoints (Set to your Railway backend URL in Vercel)
NEXT_PUBLIC_API_BASE_URL=https://web-production-xxxx.up.railway.app
NEXT_PUBLIC_WS_BASE_URL=wss://web-production-xxxx.up.railway.app
BACKEND_URL=https://web-production-xxxx.up.railway.app

# GoForge page: leave unset or false to show "Coming soon"; set true when the first launch is near
NEXT_PUBLIC_GOFORGE_LIVE=false
